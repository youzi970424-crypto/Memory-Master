MEMORY_MASTER_PROVIDER=qwen
MEMORY_MASTER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_MASTER_EMBEDDING_MODEL=text-embedding-v4
MEMORY_MASTER_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_API_KEY=replace-with-your-api-key
# Optional: complete Cohere-compatible rerank endpoint; blank uses local ranking.
MEMORY_MASTER_RERANKER_URL=
MEMORY_MASTER_RERANKER_MODEL=
MEMORY_MASTER_RERANKER_API_KEY=
# Reject automatic candidates below this reranker relevance score; calibrate per model.
MEMORY_MASTER_RERANK_THRESHOLD=0.10
